{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeOperations",
  "description": "JSON schema for atomic code and filesystem operations generated by LDrago Coding Brain",
  "type": "object",
  "required": [
    "operations"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Identifier of the task associated with these operations"
    },
    "summary": {
      "type": "string",
      "description": "High-level summary of proposed changes"
    },
    "operations": {
      "type": "array",
      "description": "Ordered sequence of atomic operations to execute",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "reason",
          "risk_level"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "replace_range",
              "create_file",
              "delete_file",
              "rename_file",
              "command_proposal"
            ],
            "description": "The type of operation to perform"
          },
          "reason": {
            "type": "string",
            "description": "Justification for this specific operation"
          },
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "Risk assessment for executing this operation"
          },
          "path": {
            "type": "string",
            "description": "Target relative file path (for file operations)"
          },
          "base_hash": {
            "type": "string",
            "description": "Expected SHA256 of the existing file to prevent race conditions or stale patches"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based inclusive start line for replace_range"
          },
          "end_line": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based inclusive end line for replace_range"
          },
          "content": {
            "type": "string",
            "description": "Full new file content (for create_file)"
          },
          "new_content": {
            "type": "string",
            "description": "Replacement block content (for replace_range)"
          },
          "old_path": {
            "type": "string",
            "description": "Source path for rename_file"
          },
          "new_path": {
            "type": "string",
            "description": "Destination path for rename_file"
          },
          "command": {
            "type": "string",
            "description": "Executable name or shell string (for command_proposal)"
          },
          "argv": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Argument vector to execute without implicit shell expansion"
          },
          "cwd": {
            "type": "string",
            "description": "Working directory relative to project root (defaults to root)"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum execution time before SIGTERM/SIGKILL"
          },
          "rollback": {
            "type": "string",
            "description": "Command or instructions to reverse this operation if it fails"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "replace_range" } }
            },
            "then": {
              "required": ["path", "base_hash", "start_line", "end_line", "new_content"]
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "create_file" } }
            },
            "then": {
              "required": ["path", "content"]
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "delete_file" } }
            },
            "then": {
              "required": ["path", "base_hash"]
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "rename_file" } }
            },
            "then": {
              "required": ["old_path", "new_path"]
            }
          },
          {
            "if": {
              "properties": { "kind": { "const": "command_proposal" } }
            },
            "then": {
              "required": ["command", "argv", "rollback"]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

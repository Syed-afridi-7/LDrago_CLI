{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodingPlan",
  "description": "JSON schema for structured coding task plans generated by LDrago Coding Brain",
  "type": "object",
  "required": [
    "objective",
    "assumptions",
    "files",
    "steps",
    "risks",
    "tests"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "description": "Clear and measurable technical objective of the proposed plan"
    },
    "assumptions": {
      "type": "array",
      "description": "Assumptions made regarding architecture, dependencies, or environment",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "description": "Files expected to be inspected, created, modified, or removed",
      "items": {
        "type": "object",
        "required": ["path", "action", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Normalized repository-relative file path"
          },
          "action": {
            "type": "string",
            "enum": ["read", "create", "modify", "delete"],
            "description": "Intended action for this file"
          },
          "reason": {
            "type": "string",
            "description": "Technical justification for why this file is affected"
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "description": "Ordered sequence of atomic execution steps",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "target_files",
          "dependencies",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this step, e.g. 'step_01'"
          },
          "description": {
            "type": "string",
            "description": "Concrete technical explanation of changes to execute"
          },
          "target_files": {
            "type": "array",
            "description": "Files targeted by this step",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "description": "Identifiers of predecessor steps that must complete first",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "string",
            "description": "Deterministic check or command proving this step succeeded"
          }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "description": "Identified architectural, runtime, or regression risks",
      "items": {
        "type": "object",
        "required": ["risk", "severity", "mitigation"],
        "properties": {
          "risk": {
            "type": "string",
            "description": "Description of potential failure or unintended side effect"
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "Severity assessment of the risk"
          },
          "mitigation": {
            "type": "string",
            "description": "Preventive safeguard or contingency plan"
          }
        },
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "array",
      "description": "Verification test suite and assertions",
      "items": {
        "type": "object",
        "required": ["name", "type", "command", "expected_outcome"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Descriptive name for the test"
          },
          "type": {
            "type": "string",
            "enum": ["unit", "integration", "regression", "smoke", "manual"],
            "description": "Classification of the test"
          },
          "command": {
            "type": "string",
            "description": "Terminal command to execute the test suite or assertion"
          },
          "expected_outcome": {
            "type": "string",
            "description": "Deterministic criteria for test success"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

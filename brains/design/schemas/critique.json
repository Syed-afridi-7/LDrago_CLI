{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UXCritique",
  "description": "JSON schema for interface design evaluations and accessibility audits generated by LDrago Design Brain",
  "type": "object",
  "required": [
    "target",
    "observations",
    "evidence",
    "severity",
    "recommendations",
    "a11y_compliance"
  ],
  "properties": {
    "target": {
      "type": "string",
      "description": "Component, view, route, or design artifact subjected to critique"
    },
    "visual_evidence_available": {
      "type": "boolean",
      "description": "Whether visual screenshots or browser previews were used during this critique"
    },
    "severity": {
      "type": "string",
      "enum": ["blocker", "critical", "major", "minor", "suggestion"],
      "description": "Aggregate severity of findings"
    },
    "observations": {
      "type": "array",
      "description": "Granular UX and visual observations",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "target_element",
          "description",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique observation identifier"
          },
          "category": {
            "type": "string",
            "enum": [
              "visual",
              "interaction",
              "information_architecture",
              "content",
              "performance",
              "state_coverage"
            ],
            "description": "Domain of UX observation"
          },
          "target_element": {
            "type": "string",
            "description": "DOM selector, component name, or visual landmark"
          },
          "description": {
            "type": "string",
            "description": "Detailed explanation of what was observed and why it is problematic"
          },
          "severity": {
            "type": "string",
            "enum": ["blocker", "critical", "major", "minor", "suggestion"],
            "description": "Severity of this individual observation"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "description": "Concrete citations, measurements, or screenshot artifacts supporting observations",
      "items": {
        "type": "object",
        "required": [
          "type",
          "reference",
          "details"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "screenshot",
              "code_inspection",
              "heuristic_evaluation",
              "standard_violation"
            ],
            "description": "Form of evidence"
          },
          "reference": {
            "type": "string",
            "description": "File path, screenshot ID, CSS selector, or rule citation"
          },
          "details": {
            "type": "string",
            "description": "Specific measurement, code excerpt, or contrast calculation"
          }
        },
        "additionalProperties": false
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Actionable, prioritized design and code recommendations",
      "items": {
        "type": "object",
        "required": [
          "action",
          "rationale",
          "impact",
          "effort"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "Specific design or code modification recommended"
          },
          "rationale": {
            "type": "string",
            "description": "UX or accessibility principle motivating this action"
          },
          "impact": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Expected positive impact on user experience"
          },
          "effort": {
            "type": "string",
            "enum": ["trivial", "low", "medium", "high"],
            "description": "Estimated implementation complexity"
          },
          "suggested_tokens": {
            "type": "array",
            "description": "Design system tokens to use for remediation",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "a11y_compliance": {
      "type": "object",
      "description": "Accessibility assessment against WCAG guidelines",
      "required": [
        "target_standard",
        "compliant",
        "issues"
      ],
      "properties": {
        "target_standard": {
          "type": "string",
          "enum": ["WCAG_2.1_AA", "WCAG_2.1_AAA", "Section_508"],
          "description": "Compliance benchmark evaluated"
        },
        "compliant": {
          "type": "boolean",
          "description": "Whether the target meets the full benchmark standard"
        },
        "score_estimate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Estimated compliance percentage score"
        },
        "issues": {
          "type": "array",
          "description": "Specific accessibility violations identified",
          "items": {
            "type": "object",
            "required": [
              "criterion",
              "element",
              "violation",
              "remediation",
              "severity"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "description": "WCAG Success Criterion identifier, e.g. '1.4.3 Contrast (Minimum)'"
              },
              "element": {
                "type": "string",
                "description": "Implicated DOM node or component"
              },
              "violation": {
                "type": "string",
                "description": "Explanation of non-compliance (e.g., contrast 2.8:1 below 4.5:1 required)"
              },
              "remediation": {
                "type": "string",
                "description": "Specific steps to achieve full compliance"
              },
              "severity": {
                "type": "string",
                "enum": ["critical", "serious", "moderate", "minor"],
                "description": "Impact on assistive tech users"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

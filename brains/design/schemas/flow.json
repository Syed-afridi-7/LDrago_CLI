{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserFlow",
  "description": "JSON schema for user journeys, interaction flows, and screen state completeness generated by LDrago Design Brain",
  "type": "object",
  "required": [
    "flow_name",
    "actors",
    "entry_points",
    "happy_path",
    "alternate_paths",
    "screen_states"
  ],
  "properties": {
    "flow_name": {
      "type": "string",
      "description": "Name or title of the user flow"
    },
    "description": {
      "type": "string",
      "description": "High-level overview of the goal this flow accomplishes"
    },
    "actors": {
      "type": "array",
      "description": "User personas or system roles participating in this flow",
      "items": {
        "type": "string"
      }
    },
    "entry_points": {
      "type": "array",
      "description": "Routes, triggers, deep links, or user actions that initiate this flow",
      "items": {
        "type": "string"
      }
    },
    "happy_path": {
      "type": "array",
      "description": "Ideal linear sequence of user actions and system responses to complete the task",
      "items": {
        "type": "object",
        "required": [
          "step",
          "screen",
          "user_action",
          "system_response"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based sequence index"
          },
          "actor": {
            "type": "string",
            "description": "Role executing this action"
          },
          "screen": {
            "type": "string",
            "description": "Screen, modal, or view where the action occurs"
          },
          "user_action": {
            "type": "string",
            "description": "Specific user interaction (e.g., click, tap, enter text)"
          },
          "system_response": {
            "type": "string",
            "description": "System UI feedback, transition, or state mutation"
          },
          "next_screen": {
            "type": "string",
            "description": "Destination view following system response"
          }
        },
        "additionalProperties": false
      }
    },
    "alternate_paths": {
      "type": "array",
      "description": "Branching paths, edge scenarios, validation failures, or cancellation flows",
      "items": {
        "type": "object",
        "required": [
          "id",
          "trigger_condition",
          "branch_point",
          "steps",
          "recovery_or_exit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier for the alternate path (e.g., 'alt_auth_failed')"
          },
          "trigger_condition": {
            "type": "string",
            "description": "Condition under which this path is taken"
          },
          "branch_point": {
            "type": "string",
            "description": "Screen or happy-path step where divergence occurs"
          },
          "steps": {
            "type": "array",
            "description": "Actions and responses within this branch",
            "items": {
              "type": "object",
              "required": ["action", "system_response"],
              "properties": {
                "action": { "type": "string" },
                "system_response": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "recovery_or_exit": {
            "type": "string",
            "description": "How the user returns to the primary flow or gracefully exits"
          }
        },
        "additionalProperties": false
      }
    },
    "screen_states": {
      "type": "array",
      "description": "Comprehensive 6-pillar UI state definitions for each screen in the flow",
      "items": {
        "type": "object",
        "required": [
          "screen_name",
          "states"
        ],
        "properties": {
          "screen_name": {
            "type": "string",
            "description": "Screen identifier"
          },
          "route": {
            "type": "string",
            "description": "Application route or view path"
          },
          "states": {
            "type": "object",
            "required": [
              "loading",
              "empty",
              "error",
              "disabled",
              "responsive",
              "a11y"
            ],
            "properties": {
              "loading": {
                "type": "object",
                "required": ["visual_treatment", "interaction"],
                "properties": {
                  "visual_treatment": { "type": "string" },
                  "interaction": { "type": "string" }
                },
                "additionalProperties": false
              },
              "empty": {
                "type": "object",
                "required": ["condition", "message", "cta"],
                "properties": {
                  "condition": { "type": "string" },
                  "message": { "type": "string" },
                  "cta": { "type": "string" }
                },
                "additionalProperties": false
              },
              "error": {
                "type": "object",
                "required": ["trigger", "visual_treatment", "recovery_action"],
                "properties": {
                  "trigger": { "type": "string" },
                  "visual_treatment": { "type": "string" },
                  "recovery_action": { "type": "string" }
                },
                "additionalProperties": false
              },
              "disabled": {
                "type": "object",
                "required": ["condition", "visual_treatment", "explanation_affordance"],
                "properties": {
                  "condition": { "type": "string" },
                  "visual_treatment": { "type": "string" },
                  "explanation_affordance": { "type": "string" }
                },
                "additionalProperties": false
              },
              "responsive": {
                "type": "object",
                "required": ["mobile", "tablet", "desktop"],
                "properties": {
                  "mobile": { "type": "string" },
                  "tablet": { "type": "string" },
                  "desktop": { "type": "string" }
                },
                "additionalProperties": false
              },
              "a11y": {
                "type": "object",
                "required": ["keyboard_navigation", "screen_reader_announcements", "focus_management"],
                "properties": {
                  "keyboard_navigation": { "type": "string" },
                  "screen_reader_announcements": { "type": "string" },
                  "focus_management": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DesignHandoff",
  "description": "JSON schema for UX-to-code developer handoff specifications generated by LDrago Design Brain",
  "type": "object",
  "required": [
    "handoff_id",
    "title",
    "components",
    "props",
    "states",
    "events",
    "tokens",
    "acceptance_criteria"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "description": "Unique identifier for this handoff package (e.g., 'handoff_auth_modal_v1')"
    },
    "title": {
      "type": "string",
      "description": "Title of the screen, pattern, or component package"
    },
    "summary": {
      "type": "string",
      "description": "Overview of engineering requirements and design intent"
    },
    "components": {
      "type": "array",
      "description": "Component hierarchy and semantic definitions",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "html_tag_or_base"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "PascalCase component name (e.g., 'SettingsTabs')"
          },
          "description": {
            "type": "string",
            "description": "Component purpose and structural role"
          },
          "html_tag_or_base": {
            "type": "string",
            "description": "Semantic HTML element or base primitive (e.g., 'nav', 'dialog', '<button>')"
          },
          "children_or_slots": {
            "type": "array",
            "description": "Sub-components, child slots, or containment boundaries",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "props": {
      "type": "array",
      "description": "Strongly-typed component property definitions",
      "items": {
        "type": "object",
        "required": [
          "component",
          "name",
          "type",
          "required",
          "description"
        ],
        "properties": {
          "component": {
            "type": "string",
            "description": "Component name this prop belongs to"
          },
          "name": {
            "type": "string",
            "description": "Prop identifier (e.g., 'variant', 'isDisabled')"
          },
          "type": {
            "type": "string",
            "description": "TypeScript type definition (e.g., 'boolean', \"'primary' | 'secondary'\", '() => void')"
          },
          "default": {
            "description": "Default fallback value if optional"
          },
          "required": {
            "type": "boolean",
            "description": "Whether the property must be provided"
          },
          "description": {
            "type": "string",
            "description": "Purpose and behavioral impact of this prop"
          }
        },
        "additionalProperties": false
      }
    },
    "states": {
      "type": "array",
      "description": "Component state machine variants and visual behaviors",
      "items": {
        "type": "object",
        "required": [
          "component",
          "name",
          "visual_representation",
          "trigger"
        ],
        "properties": {
          "component": {
            "type": "string",
            "description": "Component name"
          },
          "name": {
            "type": "string",
            "description": "State name (e.g., 'loading', 'empty', 'error', 'disabled', 'focused', 'hovered')"
          },
          "visual_representation": {
            "type": "string",
            "description": "Explicit styling, token usage, or visual changes in this state"
          },
          "trigger": {
            "type": "string",
            "description": "Condition or event entering this state"
          },
          "aria_attributes": {
            "type": "object",
            "description": "ARIA attributes applied during this state (e.g., {'aria-disabled': 'true'})",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "description": "DOM and component events emitted or handled",
      "items": {
        "type": "object",
        "required": [
          "component",
          "name",
          "payload",
          "handler_expectation"
        ],
        "properties": {
          "component": {
            "type": "string",
            "description": "Component emitting or handling the event"
          },
          "name": {
            "type": "string",
            "description": "Event name (e.g., 'onTabChange', 'onDismiss')"
          },
          "payload": {
            "type": "string",
            "description": "Data type or signature passed with the event"
          },
          "handler_expectation": {
            "type": "string",
            "description": "Expected state mutation or side effect triggered by the event"
          }
        },
        "additionalProperties": false
      }
    },
    "tokens": {
      "type": "array",
      "description": "Design system tokens explicitly assigned to this component",
      "items": {
        "type": "object",
        "required": [
          "category",
          "token_name",
          "value",
          "usage"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["color", "typography", "spacing", "elevation", "motion", "radius"],
            "description": "Token classification"
          },
          "token_name": {
            "type": "string",
            "description": "Canonical token name (e.g., 'color.surface.canvas')"
          },
          "value": {
            "type": "string",
            "description": "Underlying computed value (e.g., '#FFFFFF', '16px')"
          },
          "usage": {
            "type": "string",
            "description": "Where and how this token is applied"
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "description": "Testable and verifiable frontend acceptance criteria",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

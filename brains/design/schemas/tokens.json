{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DesignTokens",
  "description": "JSON schema for semantic design token definitions generated by LDrago Design Brain",
  "type": "object",
  "required": [
    "version",
    "colors",
    "typography",
    "spacing",
    "elevations",
    "motion"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Token dictionary semantic version, e.g. '1.0.0'"
    },
    "system_name": {
      "type": "string",
      "description": "Name of the design token system or theme"
    },
    "colors": {
      "type": "object",
      "description": "Semantic color tokens categorized by functional role",
      "required": [
        "primary",
        "surface",
        "text",
        "border",
        "status"
      ],
      "properties": {
        "primary": {
          "type": "object",
          "required": ["base", "hover", "active", "contrast"],
          "properties": {
            "base": { "type": "string" },
            "hover": { "type": "string" },
            "active": { "type": "string" },
            "contrast": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "secondary": {
          "type": "object",
          "properties": {
            "base": { "type": "string" },
            "hover": { "type": "string" },
            "active": { "type": "string" },
            "contrast": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "surface": {
          "type": "object",
          "required": ["canvas", "elevated", "sunken"],
          "properties": {
            "canvas": { "type": "string" },
            "elevated": { "type": "string" },
            "sunken": { "type": "string" },
            "overlay": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "text": {
          "type": "object",
          "required": ["primary", "secondary", "disabled", "inverse"],
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" },
            "muted": { "type": "string" },
            "disabled": { "type": "string" },
            "inverse": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "border": {
          "type": "object",
          "required": ["subtle", "standard", "focus"],
          "properties": {
            "subtle": { "type": "string" },
            "standard": { "type": "string" },
            "strong": { "type": "string" },
            "focus": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "status": {
          "type": "object",
          "required": ["success", "warning", "error", "info"],
          "properties": {
            "success": { "type": "string" },
            "warning": { "type": "string" },
            "error": { "type": "string" },
            "info": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "description": "Font families, typographic scales, font weights, and line heights",
      "required": [
        "font_families",
        "font_sizes",
        "font_weights",
        "line_heights"
      ],
      "properties": {
        "font_families": {
          "type": "object",
          "required": ["sans", "mono"],
          "properties": {
            "sans": { "type": "string" },
            "mono": { "type": "string" },
            "serif": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "font_sizes": {
          "type": "object",
          "required": ["xs", "sm", "base", "lg", "xl", "2xl"],
          "properties": {
            "xs": { "type": "string" },
            "sm": { "type": "string" },
            "base": { "type": "string" },
            "lg": { "type": "string" },
            "xl": { "type": "string" },
            "2xl": { "type": "string" },
            "3xl": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "font_weights": {
          "type": "object",
          "required": ["regular", "medium", "semibold", "bold"],
          "properties": {
            "regular": { "type": "integer" },
            "medium": { "type": "integer" },
            "semibold": { "type": "integer" },
            "bold": { "type": "integer" }
          },
          "additionalProperties": { "type": "integer" }
        },
        "line_heights": {
          "type": "object",
          "required": ["tight", "normal", "relaxed"],
          "properties": {
            "tight": { "type": "number" },
            "normal": { "type": "number" },
            "relaxed": { "type": "number" }
          },
          "additionalProperties": { "type": "number" }
        },
        "letter_spacings": {
          "type": "object",
          "properties": {
            "tight": { "type": "string" },
            "normal": { "type": "string" },
            "wide": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "spacing": {
      "type": "object",
      "description": "Consistent geometric scale for layout margins, paddings, and gaps",
      "required": [
        "base_unit",
        "scale"
      ],
      "properties": {
        "base_unit": {
          "type": "string",
          "description": "Base incremental multiplier, e.g. '4px' or '8px'"
        },
        "scale": {
          "type": "object",
          "required": ["0", "1", "2", "3", "4", "6", "8", "12", "16"],
          "properties": {
            "0": { "type": "string" },
            "1": { "type": "string" },
            "2": { "type": "string" },
            "3": { "type": "string" },
            "4": { "type": "string" },
            "6": { "type": "string" },
            "8": { "type": "string" },
            "12": { "type": "string" },
            "16": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "elevations": {
      "type": "object",
      "description": "Depth, box-shadow levels, and z-index ordering",
      "required": [
        "shadows",
        "z_indices"
      ],
      "properties": {
        "shadows": {
          "type": "object",
          "required": ["flat", "low", "medium", "high"],
          "properties": {
            "flat": { "type": "string" },
            "low": { "type": "string" },
            "medium": { "type": "string" },
            "high": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "z_indices": {
          "type": "object",
          "required": ["base", "dropdown", "sticky", "modal", "toast"],
          "properties": {
            "base": { "type": "integer" },
            "dropdown": { "type": "integer" },
            "sticky": { "type": "integer" },
            "modal": { "type": "integer" },
            "popover": { "type": "integer" },
            "toast": { "type": "integer" }
          },
          "additionalProperties": { "type": "integer" }
        }
      },
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "description": "Animation timing durations and transition curves",
      "required": [
        "durations",
        "easings"
      ],
      "properties": {
        "durations": {
          "type": "object",
          "required": ["fast", "normal", "slow"],
          "properties": {
            "fast": { "type": "string" },
            "normal": { "type": "string" },
            "slow": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "easings": {
          "type": "object",
          "required": ["standard", "decelerate", "accelerate"],
          "properties": {
            "standard": { "type": "string" },
            "decelerate": { "type": "string" },
            "accelerate": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
